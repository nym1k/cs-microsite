---
interface Props {
  formUrl?: string;
}
const { formUrl } = Astro.props;
---

{formUrl ? (
  <section class="w-full bg-[#333] py-10">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="font-heading uppercase tracking-widest text-lg mb-6">mailing list</h2>
      <div set:html={`<iframe src="${formUrl}" width="100%" height="200" frameborder="0"></iframe>`} />
    </div>
  </section>
) : null}
